# Server-side only. Never use NEXT_PUBLIC_ for these values.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Default: gemini-3.6-flash (available to new Gemini API users and tool-capable).
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini when omitted.
OPENAI_MODEL=gpt-5-mini

# Public browser configuration only. Never place a service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Disposable synthetic accounts only. Keep these out of source control and do
# not reuse a personal BruMath account for the remote persistence harness.
SUPABASE_E2E_USER_A_EMAIL=
SUPABASE_E2E_USER_A_PASSWORD=
SUPABASE_E2E_USER_B_EMAIL=
SUPABASE_E2E_USER_B_PASSWORD=
# Preview-only bearer token required by POST /api/internal/supabase-e2e.
SUPABASE_E2E_TRIGGER_TOKEN=
