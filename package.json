{
  "name": "brumath",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:bdd": "node scripts/validate-bdd.mjs",
    "test:unit": "node scripts/run-node-tests.mjs",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "test:supabase:e2e": "node scripts/run-supabase-e2e.mjs",
    "test:ci": "pnpm test:bdd && pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.30",
    "openai": "^7.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "^5.6.3"
  }
}
